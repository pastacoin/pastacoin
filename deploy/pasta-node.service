[Unit]
Description=PaSta seed node
After=network-online.target
Wants=network-online.target

[Service]
User=pasta
Group=pasta
WorkingDirectory=/opt/pasta/src
EnvironmentFile=/etc/pasta-node.env
Environment=PASTA_STORAGE=/var/lib/pasta/chain.json
# Exactly one worker: the chain lives in this process's memory.
ExecStart=/opt/pasta/venv/bin/gunicorn --workers 1 --threads 8 --bind 127.0.0.1:5000 --timeout 120 "pasta.node:create_default_app()"
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pasta

[Install]
WantedBy=multi-user.target
